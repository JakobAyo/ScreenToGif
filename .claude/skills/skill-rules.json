{
  "version": "1.0",
  "description": "Skill activation triggers for Claude Code. Controls when skills automatically suggest or block actions.",
  "skills": {
    "skill-developer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Meta-skill for creating and managing Claude Code skills",
      "promptTriggers": {
        "keywords": [
          "skill system",
          "create skill",
          "add skill",
          "skill triggers",
          "skill rules",
          "hook system",
          "skill development",
          "skill-rules.json"
        ],
        "intentPatterns": [
          "(how do|how does|explain).*?skill",
          "(create|add|modify|build).*?skill",
          "skill.*?(work|trigger|activate|system)"
        ]
      }
    },
    "clean-code-enforcer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Enforces design patterns, clean code principles, and SRP for maintainable code",
      "promptTriggers": {
        "keywords": [
          "design pattern",
          "refactor",
          "clean code",
          "single responsibility",
          "SOLID",
          "architecture",
          "modular",
          "maintainability",
          "code structure",
          "separation of concerns",
          "dependency injection",
          "factory pattern",
          "repository pattern",
          "service pattern",
          "strategy pattern",
          "observer pattern"
        ],
        "intentPatterns": [
          "(create|write|add|implement|build).*?(class|component|service|module|function)",
          "(refactor|reorganize|restructure|improve).*?code",
          "(write|create|implement).*?(new|feature|functionality)",
          "(design|architect|structure).*?(system|application|feature)",
          "make.*?(modular|maintainable|clean)",
          "(apply|use|implement).*?(pattern|principle)"
        ]
      }
    }
  },
  "notes": {
    "enforcement_types": {
      "suggest": "Skill suggestion appears but doesn't block execution",
      "block": "Requires skill to be used before proceeding (guardrail)",
      "warn": "Shows warning but allows proceeding"
    },
    "priority_levels": {
      "critical": "Highest - Always trigger when matched",
      "high": "Important - Trigger for most matches",
      "medium": "Moderate - Trigger for clear matches",
      "low": "Optional - Trigger only for explicit matches"
    },
    "customization": {
      "pathPatterns": "Adjust to match your project structure (blog-api, auth-service, etc.)",
      "keywords": "Add domain-specific terms relevant to your project",
      "intentPatterns": "Use regex for flexible user intent matching"
    }
  }
}
